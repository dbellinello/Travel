<style>
:root {
 --bg: #f6f4f0;
 --surface: #ffffff;
 --surface2: #f0ede8;
 --border: #d8d4cc;
 --border2: #e6e2da;
 --text: #1a1917;
 --muted: #6a6660;
 --accent: #7a5c0e;
 --accent2: #5c3d11;
 --navy: #1a3a8b;
 --green: #2a6a2a;
 --gold: #c8961a;
 --delta: #b01028;
 --d1: #6a1a1a;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
 background: var(--bg);
 color: var(--text);
 font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
 min-height: 100vh;
 padding-bottom: 80px;
}
.top-stripe { height: 4px; display: flex; }
.ts-navy { flex: 5; background: var(--navy); }
.ts-gold { flex: 1; background: var(--gold); }
.ts-green { flex: 2; background: var(--green); }
.nav {
 background: var(--surface2);
 border-bottom: 1px solid var(--border);
 padding: 0;
 display: flex;
 align-items: center;
 gap: 20px;
 flex-wrap: wrap;
 position: sticky;
 top: 0;
 z-index: 100;
}
.nav-inner { max-width: 940px; margin: 0 auto; padding: 10px 24px; display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
.nav-logo { font-size: 14px; font-weight: 700; color: var(--accent); letter-spacing: 0.06em; margin-right: 6px; white-space: nowrap; text-transform: uppercase; }
.nav-links { display: flex; flex-wrap: wrap; gap: 5px; }
.nav-link {
 font-size: 12px; color: var(--muted); text-decoration: none;
 padding: 2px 8px; border: 1px solid var(--border); border-radius: 3px;
 transition: color .15s, border-color .15s; background: none; letter-spacing: 0.04em;
}
.nav-link:hover { color: var(--accent); border-color: var(--accent); }
.wrap { max-width: 940px; margin: 0 auto; padding: 0 24px; }
.back-link {
 display: inline-flex; align-items: center; gap: 6px;
 font-size: 14px; color: var(--muted); text-decoration: none; margin-top: 24px;
}
.back-link:hover { color: var(--accent); }
.page-header { padding: 28px 0 22px; border-bottom: 1px solid var(--border); margin-bottom: 28px; }
.page-header-eyebrow { font-size: 11px; letter-spacing: 0.25em; text-transform: uppercase; color: var(--muted); margin-bottom: 8px; }
.page-header h1 { font-size: clamp(18px, 2.8vw, 26px); font-weight: 600; color: var(--accent2); margin-bottom: 8px; letter-spacing: -0.01em; }
.page-header p { font-size: 14px; color: var(--muted); max-width: 620px; line-height: 1.7; }
.legend {
 display: flex; flex-wrap: wrap; gap: 20px; margin-bottom: 32px;
 padding: 14px 18px; background: var(--surface); border: 1px solid var(--border); border-radius: 6px;
}
.legend-group { display: flex; flex-direction: column; gap: 7px; }
.legend-group-label { font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); font-weight: 700; }
.legend-items { display: flex; flex-wrap: wrap; gap: 10px; }
.legend-item { display: flex; align-items: center; gap: 7px; font-size: 15px; color: var(--muted); }
.dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }
.dot-navy { background: var(--navy); }
.dot-green { background: var(--green); }
.dot-gold { background: var(--gold); }
.dot-delta { background: var(--delta); }
.dot-d1 { background: var(--d1); }
.group-header {
 display: flex; align-items: center; gap: 12px;
 margin: 36px 0 16px; padding-bottom: 8px; border-bottom: 1px solid var(--border);
}
.group-title { font-size: 16px; font-weight: 600; color: var(--accent2); letter-spacing: 0.02em; }
.group-sub { font-size: 12px; color: var(--muted); letter-spacing: 0.06em; margin-left: auto; }
.airport-card { background: var(--surface); border: 1px solid var(--border); border-radius: 6px; overflow: hidden; margin-bottom: 12px; }
.airport-card-header {
 display: flex; align-items: baseline; gap: 14px;
 padding: 14px 20px 12px; background: var(--surface2); border-bottom: 1px solid var(--border);
}
.airport-code { font-size: 20px; font-weight: 700; color: var(--accent); line-height: 1; letter-spacing: 0.02em; }
.airport-city { font-size: 14px; color: var(--text); }
.airport-full { font-size: 14px; color: var(--muted); margin-left: auto; }
.airport-note {
 font-size: 14px; color: var(--muted); font-style: italic;
 padding: 7px 20px 9px; background: var(--surface2); border-bottom: 1px solid var(--border); line-height: 1.5;
}
.section-label { font-size: 13px; letter-spacing: 0.18em; text-transform: uppercase; padding: 7px 20px; border-bottom: 1px solid var(--border2); }
.section-label.skyteam { color: var(--navy); background: #eef0f7; }
.section-label.pp { color: var(--green); background: #eef5ee; }
.lounge-item { padding: 13px 20px; border-bottom: 1px solid var(--border2); }
.lounge-item:last-child { border-bottom: none; }
.lounge-header { display: flex; align-items: center; gap: 8px; margin-bottom: 7px; flex-wrap: wrap; }
.lounge-name { font-size: 15px; font-weight: 600; color: var(--text); }
.tag { font-size: 12px; letter-spacing: 0.1em; padding: 2px 7px; border-radius: 2px; background: #e8e4dc; color: var(--muted); text-transform: uppercase; }
.tag.d1 { background: #f8e8e8; color: var(--d1); }
.tag.new { background: #e8f4e8; color: #1a4a1a; }
.tag.temp { background: #f8f0e0; color: #a06010; }
.tag.flagship { background: #e8eaf8; color: #2a3a9a; }
.meta { display: flex; flex-direction: column; gap: 4px; }
.meta-row { display: flex; gap: 10px; align-items: baseline; }
.meta-label { font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); flex-shrink: 0; min-width: 72px; }
.meta-value { font-size: 15px; color: var(--text); line-height: 1.4; }
.no-access { font-size: 15px; color: var(--muted); font-style: italic; padding: 9px 20px; }
.page-footer {
 max-width: 940px; margin: 48px auto 0; padding: 16px 24px 0;
 border-top: 1px solid var(--border); font-size: 15px; color: var(--muted);
 display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px;
  background: #e8e4dc;
}
@media (max-width: 600px) {
 .nav { padding: 10px 14px; }
 .wrap { padding: 0 14px; }
 .meta { flex-direction: column; }
 .airport-code { font-size: 21px; }
 .airport-full { display: none; }
}

  .essentials {
  background: var(--surface2);
  border-bottom: 1px solid var(--border);
  padding: 6px 0;
}
.essentials-inner {
  max-width: 940px;
  margin: 0 auto;
  padding: 0 24px;
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  align-items: center;
}
.essentials-link {
  font-size: 12px;
  color: var(--muted);
  text-decoration: none;
  padding: 3px 9px;
  border: 1px solid var(--border);
  border-radius: 3px;
  background: none;
  white-space: nowrap;
}
.essentials-link:hover { color: var(--accent); border-color: var(--accent); }

/* ── Polish additions ── */
html { scroll-behavior: smooth; }

/* Frosted nav */
.nav { backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); background: rgba(240,238,234,0.88); }

/* Card hover lifts */
.trip          { transition: box-shadow .18s, transform .18s; }
.trip:hover    { box-shadow: 0 4px 16px rgba(0,0,0,0.08); transform: translateY(-1px); }
.airport-card        { transition: box-shadow .18s, transform .18s; }
.airport-card:hover  { box-shadow: 0 4px 14px rgba(0,0,0,0.08); transform: translateY(-1px); }
.dest-card           { transition: box-shadow .18s, transform .18s; }
.dest-card:hover     { box-shadow: 0 3px 10px rgba(0,0,0,0.09); transform: translateY(-1px); }
.country-block       { transition: box-shadow .18s, transform .18s; }
.country-block:hover { box-shadow: 0 3px 12px rgba(92,61,17,0.10); transform: translateY(-1px); }

/* Flight row alternating tint */
.ftable:nth-child(even) { background: rgba(0,0,0,0.018); border-radius: 2px; }

/* Consistent transitions */
.nav-link        { transition: color .15s, border-color .15s, background .15s; }
.essentials-link { transition: color .15s, border-color .15s, background .15s; }
.nav-link:hover        { background: rgba(138,108,26,0.06); }
.essentials-link:hover { background: rgba(138,108,26,0.06); }
.lounge-item     { transition: background .15s; }
.lounge-item:hover { background: #fafaf8; }
/* ── Collapsible airports ── */
.airport-card-header { cursor:pointer; user-select:none; }
.airport-card-header::after { content:'▾'; margin-left:auto; font-size:12px; color:var(--muted); transition:transform .2s; }
.airport-card.collapsed .airport-card-header::after { transform:rotate(-90deg); }
.airport-card-body { transition:max-height .25s ease, opacity .25s ease; overflow:hidden; }
.airport-card.collapsed .airport-card-body { max-height:0!important; opacity:0; }
</style>
<script>
document.addEventListener('DOMContentLoaded',()=>{
  const page=location.pathname.split('/').pop();
  document.querySelectorAll('.essentials-link').forEach(a=>{
    if(a.getAttribute('href')&&a.getAttribute('href').split('/').pop()===page){
      a.style.borderColor='#8a6c1a';
      a.style.color='#8a6c1a';
      a.style.background='rgba(138,108,26,0.08)';
    }
  });
});
</script>
