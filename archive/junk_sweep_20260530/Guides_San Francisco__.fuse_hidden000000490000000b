    </div>
    <div class="stop-photos">
      <img src="_build/assets/800px-Dragon_Gate_San_Francisco.jpg" alt="Dragon Gate, San Francisco Chinatown">
    </div>
  </div>

  <div class="next">🚶 12 min · 🚕  5 min → Cable Car Museum</div>

  <!-- inclusion-bar: editorial — Fodor's, Atlas Obscura, SF Travel — working powerhouse for the National Historic Landmark cable car system, only one in the world -->
